{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustWA",
  "version": "0.1.0",
  "identifier": "io.github.lucas-vdr-a11y.rustwa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "rustwa"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RustWA",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 18 },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://localhost:1420; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp"
        ],
        "name": "Image",
        "description": "Image files",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "public.image"
        ]
      },
      {
        "ext": [
          "mp4",
          "mov"
        ],
        "name": "Video",
        "description": "Video files",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "public.movie"
        ]
      },
      {
        "ext": [
          "mp3",
          "ogg",
          "opus"
        ],
        "name": "Audio",
        "description": "Audio files",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "public.audio"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF documents",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ],
    "shortDescription": "Unofficial WhatsApp client for macOS, written in Rust",
    "longDescription": "RustWA is an unofficial, from-scratch WhatsApp client for macOS written in Rust. It reproduces the familiar WhatsApp layout while using a fraction of the resources of the official Catalyst app.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
